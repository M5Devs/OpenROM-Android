<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/convertFragment">

    <fragment
        android:id="@+id/convertFragment"
        android:name="com.m5dev.openrom.ui.convert.ConvertFragment"
        android:label="@string/nav_convert"
        tools:layout="@layout/fragment_convert"
        xmlns:tools="http://schemas.android.com/tools">
        <argument
            android:name="incoming_uri"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/pluginsFragment"
        android:name="com.m5dev.openrom.ui.plugins.PluginsFragment"
        android:label="@string/nav_plugins" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.m5dev.openrom.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />
</navigation>
